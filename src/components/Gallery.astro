        title: "Manicura Rusa",
        desc: "Técnica de precisión para una limpieza profunda.",
        time: "1.5h",
    },
    {
        src: "/gallery-2.jpeg",
        alt: "Nail Art",
        title: "Diseño Artístico",
        desc: "Arte personalizado realizado totalmente a mano.",
        time: "2.5h",
    },
    {
        src: "/gallery-3.jpeg",
        alt: "Chrome Nails",
        title: "Efecto Espejo",
        desc: "Acabado cromado de alto impacto y brillo.",
        time: "2.0h",
    },
    {
        src: "/gallery-4.jpeg",
        alt: "Soft Ombré",
        title: "Baby Boomer",
        desc: "Difuminado elegante y natural para el día a día.",
        time: "1.5h",
    },
    {

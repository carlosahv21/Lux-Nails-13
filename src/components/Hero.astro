---

---

<section
    id="inicio"
    class="relative min-h-screen flex items-center pt-32 overflow-hidden"
>
    <div class="container mx-auto px-6 grid md:grid-cols-2 gap-12 items-center">
        <div class="relative z-10 hero-content">
            <span
                class="inline-block uppercase tracking-[0.3em] text-xs font-bold text-brand-primary mb-6"
                >Pura Elegancia en tus Manos</span
            >
            <h1 class="text-6xl md:text-8xl leading-none mb-8">
                El Arte del <br />
                <span class="italic font-light text-brand-primary"
                    >Autocuidado</span
                >
                <br />
                y Lujo.
            </h1>
            <p
                class="text-lg text-brand-dark/70 mb-10 max-w-md leading-relaxed"
            >
                Descubre un refugio de belleza donde cada detalle importa.
                Especialistas en realzar tu esencia a través de manicuras de
                alta gama.
            </p>
            <div class="flex flex-col sm:flex-row gap-6">
                <a
                    href="#servicios"
                    class="bg-brand-primary text-brand-light px-10 py-4 rounded-full uppercase text-sm tracking-widest font-bold hover:bg-brand-dark transition-all duration-300 inline-block text-center"
                >
                    Ver Servicios
                </a>
                <a
                    href="#contacto"
                    class="border border-brand-primary text-brand-primary px-10 py-4 rounded-full uppercase text-sm tracking-widest font-bold hover:bg-brand-primary hover:text-brand-light transition-all duration-300 inline-block text-center"
                >
                    Reservar Cita
                </a>
            </div>
        </div>

        <div class="relative">
            <div
                class="hero-image-container relative rounded-[40px] overflow-hidden aspect-[4/5]"
            >
                <img
                    src="/gallery-11.jpeg"
                    alt="Luxury Nail Art"
                    loading="eager"
                    decoding="sync"
                    class="w-full h-full object-cover hero-img"
                />
                <div
                    class="absolute inset-0 bg-brand-primary/10 mix-blend-multiply"
                >
                </div>
            </div>
            <!-- Decorative elements -->
            <div
                class="absolute -bottom-10 -left-10 w-40 h-40 bg-brand-secondary rounded-full -z-10 blur-2xl opacity-60"
            >
            </div>
            <div
                class="absolute -top-10 -right-10 w-60 h-60 bg-brand-primary/20 rounded-full -z-10 blur-3xl"
            >
            </div>
        </div>
    </div>
</section>

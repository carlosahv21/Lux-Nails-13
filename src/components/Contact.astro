---

<section
    id="contacto"
    class="py-20 md:py-28 bg-brand-dark text-brand-light overflow-hidden"
>
    <div class="container mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-20">
            <div class="contact-info">
                <span
                    class="uppercase tracking-[0.3em] text-xs font-bold text-brand-primary mb-6 block"
                    >Reserva tu Momento</span
                >
                <h2 class="text-5xl md:text-6xl mb-10">¿Hablamos?</h2>
                <p class="text-brand-light/60 text-lg mb-12 max-w-sm">
                    Estamos aquí para responder tus dudas y agendar tu próxima
                    cita de belleza.
                </p>

                <div class="space-y-8">
                    <div class="flex items-center space-x-4">
                        <div
                            class="w-12 h-12 rounded-full border border-brand-light/20 flex items-center justify-center"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="text-brand-primary"
                                ><path
                                    d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"
                                ></path><circle cx="12" cy="10" r="3"
                                ></circle></svg
                            >
                        </div>
                        <div>
                            <p
                                class="text-xs uppercase tracking-widest text-brand-primary font-bold"
                            >
                                Ubicación
                            </p>
                            <p>Ecuador, Vía a la Costa, Guayaquil</p>
                        </div>
                    </div>
                    <div class="flex items-center space-x-4">
                        <div
                            class="w-12 h-12 rounded-full border border-brand-light/20 flex items-center justify-center"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="text-brand-primary"
                                ><path
                                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                                ></path></svg
                            >
                        </div>
                        <div>
                            <p
                                class="text-xs uppercase tracking-widest text-brand-primary font-bold"
                            >
                                WhatsApp
                            </p>
                            <p>+593 99 847 7161</p>
                        </div>
                    </div>
                </div>

                <div
                    class="mt-16 flex justify-center md:justify-start space-x-6"
                >
                    <a
                        href="https://instagram.com/luxnails13.ec"
                        target="_blank"
                        class="w-10 h-10 rounded-full bg-brand-light/10 flex items-center justify-center hover:bg-brand-primary transition-colors duration-300"
                        title="Instagram"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="w-5 h-5"
                            ><rect
                                width="20"
                                height="20"
                                x="2"
                                y="2"
                                rx="5"
                                ry="5"></rect><path
                                d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                            ></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"
                            ></line></svg
                        >
                    </a>

                    <a
                        href="#"
                        target="_blank"
                        class="w-10 h-10 rounded-full bg-brand-light/10 flex items-center justify-center hover:bg-brand-primary transition-colors duration-300"
                        title="Facebook"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="w-5 h-5"
                            ><path
                                d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
                            ></path></svg
                        >
                    </a>

                    <a
                        href="https://wa.me/593998477161?text=Hola, me gustaría reservar una cita."
                        target="_blank"
                        class="w-10 h-10 rounded-full bg-brand-light/10 flex items-center justify-center hover:bg-brand-primary transition-colors duration-300"
                        title="WhatsApp"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 32 32"
                            fill="currentColor"
                            class="w-5 h-5"
                            ><path
                                d="M26.576 5.363c-2.69-2.69-6.406-4.354-10.511-4.354-8.209 0-14.865 6.655-14.865 14.865 0 2.732 0.737 5.291 2.022 7.491l-0.038-0.070-2.109 7.702 7.879-2.067c2.051 1.139 4.498 1.809 7.102 1.809h0.006c8.209-0.003 14.862-6.659 14.862-14.868 0-4.103-1.662-7.817-4.349-10.507l0 0zM16.062 28.228h-0.005c-0 0-0.001 0-0.001 0-2.319 0-4.489-0.64-6.342-1.753l0.056 0.031-0.451-0.267-4.675 1.227 1.247-4.559-0.294-0.467c-1.185-1.862-1.889-4.131-1.889-6.565 0-6.822 5.531-12.353 12.353-12.353s12.353 5.531 12.353 12.353c0 6.822-5.53 12.353-12.353 12.353h-0zM22.838 18.977c-0.371-0.186-2.197-1.083-2.537-1.208-0.341-0.124-0.589-0.185-0.837 0.187-0.246 0.371-0.958 1.207-1.175 1.455-0.216 0.249-0.434 0.279-0.805 0.094-1.15-0.466-2.138-1.087-2.997-1.852l0.010 0.009c-0.799-0.74-1.484-1.587-2.037-2.521l-0.028-0.052c-0.216-0.371-0.023-0.572 0.162-0.757 0.167-0.166 0.372-0.434 0.557-0.65 0.146-0.179 0.271-0.384 0.366-0.604l0.006-0.017c0.043-0.087 0.068-0.188 0.068-0.296 0-0.131-0.037-0.253-0.101-0.357l0.002 0.003c-0.094-0.186-0.836-2.014-1.145-2.758-0.302-0.724-0.609-0.625-0.836-0.637-0.216-0.010-0.464-0.012-0.712-0.012-0.395 0.010-0.746 0.188-0.988 0.463l-0.001 0.002c-0.802 0.761-1.3 1.834-1.3 3.023 0 0.026 0 0.053 0.001 0.079l-0-0.004c0.131 1.467 0.681 2.784 1.527 3.857l-0.012-0.015c1.604 2.379 3.742 4.282 6.251 5.564l0.094 0.043c0.548 0.248 1.25 0.513 1.968 0.74l0.149 0.041c0.442 0.14 0.951 0.221 1.479 0.221 0.303 0 0.601-0.027 0.889-0.078l-0.031 0.004c1.069-0.223 1.956-0.868 2.497-1.749l0.009-0.017c0.165-0.366 0.261-0.793 0.261-1.242 0-0.185-0.016-0.366-0.047-0.542l0.003 0.019c-0.092-0.155-0.34-0.247-0.712-0.434z"
                            ></path></svg
                        >
                    </a>

                    <a
                        href="https://www.google.com/maps/place/Lux+Nails/@-2.19,-79.98"
                        target="_blank"
                        class="w-10 h-10 rounded-full bg-brand-light/10 flex items-center justify-center hover:bg-brand-primary transition-colors duration-300"
                        title="Ubicación"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="w-5 h-5"
                            ><path
                                d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                            ></path><circle cx="12" cy="10" r="3"></circle></svg
                        >
                    </a>
                </div>
            </div>

            <div class="contact-form-container">
                <form id="contact-form" class="space-y-6">
                    <div class="grid grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label
                                class="text-xs uppercase tracking-widest font-bold opacity-60"
                                >Nombre</label
                            >
                            <input
                                type="text"
                                required
                                name="name"
                                class="w-full bg-transparent border-b border-brand-light/20 py-3 focus:outline-none focus:border-brand-primary transition-colors"
                                placeholder="Tu nombre"
                            />
                        </div>
                        <div class="space-y-2">
                            <label
                                class="text-xs uppercase tracking-widest font-bold opacity-60"
                                >Correo</label
                            >
                            <input
                                type="email"
                                required
                                name="email"
                                class="w-full bg-transparent border-b border-brand-light/20 py-3 focus:outline-none focus:border-brand-primary transition-colors"
                                placeholder="tu@email.com"
                            />
                        </div>
                    </div>
                    <div class="space-y-2">
                        <label
                            class="text-xs uppercase tracking-widest font-bold opacity-60"
                            >Servicio de Interés</label
                        >
                        <select
                            name="service"
                            class="w-full bg-transparent border-b border-brand-light/20 py-3 focus:outline-none focus:border-brand-primary transition-colors appearance-none"
                        >
                            <option class="bg-brand-dark">Manicura</option>
                            <option class="bg-brand-dark">Pedicura</option>
                            <option class="bg-brand-dark">Acrílicas</option>
                            <option class="bg-brand-dark">Otros</option>
                        </select>
                    </div>
                    <div class="space-y-2">
                        <label
                            class="text-xs uppercase tracking-widest font-bold opacity-60"
                            >Mensaje</label
                        >
                        <textarea
                            rows="4"
                            required
                            name="message"
                            class="w-full bg-transparent border-b border-brand-light/20 py-3 focus:outline-none focus:border-brand-primary transition-colors resize-none"
                            placeholder="¿En qué podemos ayudarte?"></textarea>
                    </div>
                    <button
                        type="submit"
                        class="w-full bg-brand-primary text-brand-dark py-5 rounded-xl uppercase text-sm tracking-widest font-bold hover:brightness-110 transition-all mt-8"
                    >
                        Enviar Mensaje
                    </button>
                    <div
                        id="form-status"
                        class="hidden text-center py-4 rounded-xl font-bold uppercase text-xs tracking-widest border border-brand-primary text-brand-primary"
                    >
                        ¡Mensaje enviado con éxito! Nos contactaremos pronto.
                    </div>
                </form>
            </div>
        </div>

        <div
            class="pt-32 mt-32 border-t border-brand-light/10 text-center text-xs tracking-widest font-bold opacity-40"
        >
            &copy; 2026 LUX NAILS STUDIO. TODOS LOS DERECHOS RESERVADOS.
        </div>
    </div>
</section>

<script>
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const status = document.getElementById("form-status");

    form?.addEventListener("submit", (e) => {
        e.preventDefault();

        // Simple visual feedback
        const btn = form.querySelector("button");
        if (btn) {
            btn.disabled = true;
            btn.innerText = "Enviando...";
        }

        setTimeout(() => {
            if (status) {
                status.classList.remove("hidden");
                form.reset();
                if (btn) {
                    btn.classList.add("hidden");
                }

                // Reset after 5 seconds
                setTimeout(() => {
                    status.classList.add("hidden");
                    if (btn) {
                        btn.classList.remove("hidden");
                        btn.disabled = false;
                        btn.innerText = "Enviar Mensaje";
                    }
                }, 5000);
            }
        }, 1500);
    });
</script>
